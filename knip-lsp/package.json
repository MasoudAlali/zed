{
  "name": "knip-lsp",
  "version": "0.1.0",
  "description": "Language Server Protocol implementation for knip — find unused code in JS/TS projects",
  "main": "dist/server.js",
  "bin": {
    "knip-lsp": "dist/server.js"
  },
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --target=node18 --outfile=dist/server.js --format=cjs",
    "build:types": "tsc --noEmit",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.0.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.27.4",
    "typescript": "^5.4.0"
  },
  "license": "MIT"
}
